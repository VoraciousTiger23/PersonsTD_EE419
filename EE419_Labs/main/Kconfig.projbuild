menu "EE 419 Configuration"

    config LED_RED_PIN
        int "Red LED gpio number"
        default 9
        help
            GPIO number for the red LED.
        
    config LED_GREEN_PIN
        int "Green LED gpio number"
        default 6
        help
            GPIO number for the green LED.
            
    config LED_BLUE_PIN
        int "Blue LED gpio number"
        default 5
        help
            GPIO number for the blue LED.

    config TFT_MOSI_PIN
        int "TFT MOSI GPIO"
        default 23

    config TFT_MISO_PIN
        int "TFT MISO GPIO (-1 if unused)"
        default 19

    config TFT_SCK_PIN
        int "TFT SCK GPIO"
        default 18

    config TFT_CS_PIN
        int "TFT CS GPIO"
        default 15

    config TFT_DC_PIN
        int "TFT DC GPIO"
        default 33

    config TFT_RST_PIN
        int "TFT reset GPIO (-1 if unused)"
        default -1

    config TFT_BL_PIN
        int "TFT backlight GPIO (-1 if always enabled)"
        default -1

     config MQTT_BROKER
        string "AWS Endpoint"
        default "Replace with your AWS endpoint"
        help
            Name of MQTT broker

    config MQTT_PORT
        int "MQTT port"
        default 443
        help
            Port used for MQTT broker

    config MQTT_QOS
        int "MQTT Quality of Service"
        range 0 1
        default 1
        help
            QoS value for MQTT messages           
endmenu